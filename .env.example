# Server-only secrets — never referenced from client components or exposed
# via NEXT_PUBLIC_. Copy this file to .env.local and fill in real values.

MISTRAL_API_KEY=
# Not used yet — Phase 6's image provider (Pollinations) is free and needs
# no key. Reserved for swapping in a paid provider later. See
# src/lib/ai/image/providers/pollinations.ts.
IMAGE_API_KEY=
VOICE_API_KEY=
DATABASE_URL=
DIRECT_URL=

# Auth.js (Phase 11, email/password only — no OAuth provider, so no
# third-party console setup needed). Generate with `npx auth secret`
# (writes it straight into .env.local) or any random 32+ byte string —
# this signs/encrypts the session JWT, so it must stay secret and be set
# in Vercel's Environment Variables too, not just locally.
AUTH_SECRET=
