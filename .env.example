# Server-only secrets. Never referenced from client components or exposed
# via NEXT_PUBLIC_. Copy this file to .env.local and fill in real values.

# Gemini (Google AI Studio). Create a free key at aistudio.google.com/apikey
# (no billing required, free tier). Used by the chat pipeline and the
# Memory Analyzer.
GEMINI_API_KEY=
# Not used yet. The image provider (Pollinations) is free and needs no
# key. Reserved for swapping in a paid provider later. See
# src/lib/ai/image/providers/pollinations.ts.
IMAGE_API_KEY=
VOICE_API_KEY=
DATABASE_URL=
DIRECT_URL=

# Auth.js (email and password only, no OAuth provider, so no third-party
# console setup needed). Generate with `npx auth secret` (writes it
# straight into .env.local) or any random 32+ byte string. This
# signs/encrypts the session JWT, so it must stay secret and be set in
# Vercel's Environment Variables too, not just locally.
AUTH_SECRET=
